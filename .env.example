# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GoHighLevel inbound webhook (server-only; never expose to the client)
GHL_WEBHOOK_URL=

# Legacy form forwarding (unused by the current client forms)
# Supported providers: custom | gohighlevel | hubspot
FORM_PROVIDER=custom

# GoHighLevel inbound webhook or any JSON endpoint
FORM_WEBHOOK_URL=

# HubSpot Forms API (used when FORM_PROVIDER=hubspot)
HUBSPOT_PORTAL_ID=
HUBSPOT_APPLICATION_FORM_ID=
HUBSPOT_WAITLIST_FORM_ID=
